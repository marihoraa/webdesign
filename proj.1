<script>
function tentarEntrar() {
  const btn = document.getElementById('btnEntrar');
  const toast = document.getElementById('toastErro');
  const email = document.getElementById('campoEmail').value;
  const senha = document.getElementById('campoSenha').value;

  toast.classList.remove('visivel');

  if (!email || !senha) {
    toast.textContent = '👀 Parece que você esqueceu de preencher algum campo.';
    toast.classList.add('visivel');
    return;
  }

  btn.textContent = 'Entrando...';
  btn.classList.add('carregando');
  btn.disabled = true;

  setTimeout(() => {
    btn.textContent = 'Entrar no Portal →';
    btn.classList.remove('carregando');
    btn.disabled = false;
    // Simulação: se quiser mostrar sucesso, basta redirecionar ou mudar o estado aqui
  }, 1800);
}
</script>
